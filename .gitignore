### Go template
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
.DS_Store
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# IDE
.idea/

# Claude Code. Machine-local except the architecture map. The `.claude/*` form
# is load-bearing: git cannot re-include a file under an excluded directory.
.claude/*
!.claude/ARCHITECTURE.md
!.claude/rules/
.superpowers/

# Runtime data
/data/

# The e2e harness mints a throwaway CA and leaf certs on each run. Generated
# key material, never fixtures: committing them would publish private keys.
test/e2e/certs/

# Design docs (local-only). Plans are ephemeral working documents: they are
# written into docs/plans/, and the second rule catches one written beside the
# design it implements, which is where they used to land.
docs/plans/
docs/specs/*-plan.md
docs/frontend-overhaul.md
docs/task-state-timeline-design.md
docs/task-state-timeline-plan.md

# Build output
cetacean
frontend/dist/
frontend/dist-widgets/
website/dist/
website/.astro/
node_modules/
# The harvester's fixtures stand in for a real npm install, so this one
# node_modules tree is source and must stay tracked.
!scripts/licensetexts/testdata/**/node_modules/
.worktrees/
cetacean.toml
.playwright-mcp/
frontend/test-results/
