{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "repository": "https://github.com/Radiergummi/cetacean",
  "type": "module",
  "scripts": {
    "sync-assets": "rm -f public/openapi.yaml && mkdir -p public/api public/dist src/data && cp ../api/openapi.yaml public/api/openapi.yaml && cp node_modules/@scalar/api-reference/dist/browser/standalone.js public/scalar.js && cp ../compose.yaml ../compose.monitoring.yaml ../compose.prometheus.yaml ../prometheus.yml public/dist/ && (cd .. && go run ./scripts/dump-errors) > src/data/errors.json",
    "prebuild": "npm run sync-assets",
    "predev": "npm run sync-assets",
    "dev": "astro dev",
    "dev:clean": "astro dev stop; pkill -f \"$PWD/node_modules/astro/bin/astro.mjs (dev|preview)\" || true; rm -rf .astro node_modules/.vite && npm run dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "test": "playwright test",
    "audit-layout": "node e2e/audit-page.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@lucide/astro": "^1.66.0",
    "@scalar/api-reference": "^1.76.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "astro": "^7.4.4",
    "fontkit": "^2.0.4",
    "marked": "^18.1.2",
    "pagefind": "^1.5.2",
    "pele": "^1.13.0",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/unist": "^3.0.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
