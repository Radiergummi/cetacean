---
/**
 * Turns the build-time diagram SVGs into pannable, zoomable figures.
 *
 * Everything here is an enhancement: the SVG is already in the page and already
 * matches the active theme, so a reader without JavaScript loses the controls
 * and nothing else. Panzoom is behind a dynamic import guarded on a diagram
 * actually being present, so the pages without one pay nothing for it.
 */
import { Maximize, RotateCcw, ZoomIn, ZoomOut } from "@lucide/astro";

const controls = [
    { action: "zoom-in", label: "Zoom in", Icon: ZoomIn },
    { action: "zoom-out", label: "Zoom out", Icon: ZoomOut },
    { action: "reset", label: "Reset view", Icon: RotateCcw },
    { action: "fullscreen", label: "Toggle fullscreen", Icon: Maximize },
];
---

<template id="mermaid-controls-template">
    <div class="flex justify-end gap-1 border-t border-border p-1.5">
        {
            controls.map(({ action, label, Icon }) => (
                <button
                    type="button"
                    class="flex size-7 cursor-pointer items-center justify-center rounded-sm text-muted-foreground hover:bg-accent hover:text-foreground"
                    data-action={action}
                    aria-label={label}
                    title={label}
                >
                    <Icon class="size-4" aria-hidden="true" />
                </button>
            ))
        }
    </div>
</template>

<script>
    document.addEventListener("astro:page-load", async () => {
        const figures = document.querySelectorAll<HTMLElement>(
            ".mermaid-figure:not([data-interactive])",
        );

        if (figures.length === 0) {
            return;
        }

        const template = document.getElementById(
            "mermaid-controls-template",
        ) as HTMLTemplateElement | null;

        if (!template) {
            return;
        }

        const { default: Panzoom } = await import("@panzoom/panzoom");

        figures.forEach((figure) => {
            const canvas = figure.querySelector<HTMLElement>(".mermaid-canvas");
            const viewport = figure.querySelector<HTMLElement>(".mermaid-viewport");

            if (!canvas || !viewport) {
                return;
            }

            figure.setAttribute("data-interactive", "");

            const panzoom = Panzoom(canvas, {
                maxScale: 8,
                minScale: 1,
                pinchAndPan: true,
                cursor: "grab",
            });
            // Panzoom writes `cursor` as an inline style on the canvas, so no
            // stylesheet rule can swap it while dragging. `handleDown`/`handleUp`
            // take a PointerEvent rather than a callback — they exist for wiring
            // your own events under `noBind` — so the swap hangs off real ones.
            canvas.addEventListener("pointerdown", () => {
                panzoom.setOptions({ cursor: "grabbing" });
            });

            document.addEventListener("pointerup", () => {
                panzoom.setOptions({ cursor: "grab" });
            });

            // Plain scrolling stays page scrolling; zooming asks for a modifier,
            // the way a map embedded in an article does.
            viewport.addEventListener(
                "wheel",
                (event) => {
                    if (event.ctrlKey || event.metaKey) {
                        panzoom.zoomWithWheel(event);
                    }
                },
                { passive: false },
            );

            const controls = template.content.cloneNode(true) as DocumentFragment;

            controls.querySelector('[data-action="zoom-in"]')?.addEventListener("click", () =>
                panzoom.zoomIn()
            );
            controls.querySelector('[data-action="zoom-out"]')?.addEventListener("click", () =>
                panzoom.zoomOut()
            );
            controls.querySelector('[data-action="reset"]')?.addEventListener("click", () =>
                panzoom.reset()
            );
            controls
                .querySelector('[data-action="fullscreen"]')
                ?.addEventListener("click", () => {
                    if (document.fullscreenElement === figure) {
                        document.exitFullscreen();
                    } else {
                        figure.requestFullscreen();
                    }
                });

            figure.appendChild(controls);
        });
    });
</script>
