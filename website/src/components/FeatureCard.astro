---
interface Props {
    href: string;
    icon: string;
    title: string;
}

const {href, icon, title} = Astro.props;
---
<li class="contents">
    <a href={href} class="group flex flex-col rounded-2xl bg-accent p-6 gap-3">
        <h2 class="text-xl font-medium">
            <span class="me-2">{icon}</span>
            {title}
        </h2>
        <p class="text-base text-muted-foreground">
            <slot />
        </p>
        <span class="mt-auto self-end text-accent-foreground font-medium text-sm flex items-center gap-1 group-hover:translate-x-1 transition-all duration-300">
            <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-500">Read more</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 opacity-50 group-hover:opacity-100 transition-opacity duration-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m9 18 6-6-6-6" />
            </svg>
        </span>
    </a>
</li>
