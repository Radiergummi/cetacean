---
import {Link} from "@lucide/astro";
import {HTMLAttributes} from "astro/types";

interface Props extends HtmlAttributes<"h1" | "h2" | "h3" | "h4" | "h5" | "h6"> {
    level: 1 | 2 | 3 | 4 | 5 | 6 | "1" | "2" | "3" | "4" | "5" | "6";
    id?: string;
    class?: string;
    anchor?: boolean;
}

const {
    anchor,
    class: className,
    id,
    level,
    ...rest
} = Astro.props;

const Tag = `h${level}` as keyof HTMLElementTagNameMap;
---

<Tag id={id} class:list={["group w-full flex items-center", className]} {...rest}>
    <slot />

    {anchor && (
        <a
            href={`#${id}`}
            class="ms-[1em] text-sm leading-none text-muted-foreground no-underline opacity-0 transition-opacity group-hover:opacity-100 hover:text-active focus-visible:opacity-100 select-none transition duration-150"
            aria-label={`Link to ${id}`}
        >
            <Link class="size-3" />
        </a>
    )}
</Tag>
