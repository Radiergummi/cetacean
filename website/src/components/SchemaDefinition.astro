---
import Badge from "@/components/Badge.astro";
import ReferenceEntry from "@/components/ReferenceEntry.astro";
import ReferenceFacts from "@/components/ReferenceFacts.astro";

interface Props {
    name: string;
    description?: string;
    container?: string;
}

const {name, description, container} = Astro.props;
---
<ReferenceEntry
    id={name}
    class="text-sm"
    anchor
>
    <Fragment slot="heading">
        <code>{name}</code>
        {container &&
         <Badge tone="accent">{container}</Badge>}
    </Fragment>

    <slot name="description">
        {description &&
         <p>{description}</p>}
    </slot>

    <ReferenceFacts slot="facts">
        <slot name="facts" />
    </ReferenceFacts>
</ReferenceEntry>
