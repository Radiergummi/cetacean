---
import { sidebarGroups } from "../lib/navigation";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

/**
 * A link marks the page it is on with `aria-current`, and the `current` and
 * `inactive` variants read that back — so the two states are one class list
 * here rather than a choice made per link.
 */
const linkClass =
  "block rounded-md px-3 py-1.5 transition-colors current:bg-accent current:font-medium current:text-active inactive:text-muted-foreground inactive:hover:bg-accent/60 inactive:hover:text-foreground";
---

<nav class="text-sm select-none" aria-label="Documentation">
  {sidebarGroups.map((group) => (
    <div class="mb-8">
      <h3 class="text-2xs font-semibold uppercase tracking-widest text-muted-foreground mb-3 px-3">
        {group.label}
      </h3>
      <ul class="flex flex-col gap-0.5">
        {group.items.map(({ slug, title, reload }) => (
          <li>
            <a
              href={`/${slug}`}
              class={linkClass}
              aria-current={currentSlug === slug ? "page" : undefined}
              data-astro-reload={reload || undefined}
            >
              {title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <div class="border-t pt-6 mt-2">
    <a
      href="/changelog"
      class={linkClass}
      aria-current={currentSlug === "changelog" ? "page" : undefined}
    >
      Changelog
    </a>
  </div>
</nav>
