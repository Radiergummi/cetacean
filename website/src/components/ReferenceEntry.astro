---
/**
 * The shell shared by the config parameters in `docs/configuration.mdx` and the
 * schema entries on `/api/schema`: a name, an optional description, and a block
 * of facts underneath. Everything that differs between the two — the chrome and
 * the shape of the facts block — is the caller's, so this holds only what they
 * agree on.
 */
interface Props extends HTMLAttributes<"div"> {
  id: string;
  anchor?: boolean;
}

const { id, class: className, anchor = false, ...rest } = Astro.props;

/**
 * Rendered rather than probed with `Astro.slots.has`, which only reports whether
 * children were passed: a caller forwarding its own slot always passes some, so
 * only the rendered output says whether there is a description to wrap.
 */
const description = (await Astro.slots.render("default")).trim();

// Inline code carries a tinted pill from the prose layer; the name is a heading.
const headingClass = "mb-1.5 flex items-baseline gap-2 code-heading";
---
<div {...rest} id={id} class={className}>
  <div class={headingClass}>
    <slot name="heading" />
    {anchor && (
      <a
        href={`#${id}`}
        class="ml-auto text-sm leading-none text-muted-foreground no-underline opacity-0 transition-opacity group-hover:opacity-100 focus-visible:opacity-100"
        aria-label={`Link to ${id}`}
      >#</a>
    )}
  </div>
  {description && (
    <div
      class="mb-3 text-sm leading-relaxed [&>:first-child]:mt-0 [&>:last-child]:mb-0"
      set:html={description}
    />
  )}
  <slot name="facts" />
</div>
