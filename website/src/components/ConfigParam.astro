---
import Badge from "./Badge.astro";
import ReferenceEntry from "./ReferenceEntry.astro";

interface Props {
    name: string;
    flag?: string;
    env?: string;
    default?: string;
    required?: boolean;
    deprecated?: boolean;
}

const {name, flag, env, default: defaultValue, required, deprecated} = Astro.props;

const lastDot = name.lastIndexOf(".");
const prefix = lastDot === -1 ? "" : name.slice(0, lastDot + 1);
const leaf = lastDot === -1 ? name : name.slice(lastDot + 1);

const facts: { label: string; value: string }[] = [];

if (flag) {
    facts.push({label: "flag", value: flag});
}

if (env) {
    facts.push({label: "env", value: env});
}

if (defaultValue !== undefined) {
    facts.push({label: "default", value: defaultValue});
}
---

<ReferenceEntry
    id={name}
    class="group mt-2 rounded-lg border px-4 py-3.5 text-sm target:border-active target:ring-1 target:ring-active data-deprecated:opacity-60"
    data-deprecated={deprecated || undefined}
    anchor
>
    <Fragment slot="heading">
        <code>{prefix && <span class="font-normal text-muted-foreground">{prefix}</span>}{leaf}</code>
        {required && <Badge tone="accent">required</Badge>}
        {deprecated && <Badge tone="muted">deprecated</Badge>}
    </Fragment>

    <slot />

    {facts.length > 0 && (
        <ul
            slot="facts"
            class="-mx-4 -mb-3.5 flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-b-inner border-t bg-muted px-4 py-2 text-sm text-code-foreground code-plain"
        >
            {facts.map(({label, value}) => (
                <li class="inline-flex items-baseline gap-1.5">
                    <span class="font-medium text-muted-foreground">{label}</span>
                    <code>{value}</code>
                </li>
            ))}
        </ul>
    )}
</ReferenceEntry>
