---
import Badge from "./Badge.astro";
import ReferenceEntry from "./ReferenceEntry.astro";

interface Props {
  name: string
  flag?: string
  env?: string
  default?: string
  required?: boolean
  deprecated?: boolean
}

const { name, flag, env, default: defaultValue, required, deprecated } = Astro.props;

const lastDot = name.lastIndexOf(".");
const prefix = lastDot === -1 ? "" : name.slice(0, lastDot + 1);
const leaf = lastDot === -1 ? name : name.slice(lastDot + 1);

const facts: { label: string; value: string }[] = [];

if (flag) {
  facts.push({ label: "flag", value: flag });
}

if (env) {
  facts.push({ label: "env", value: env });
}

if (defaultValue !== undefined) {
  facts.push({ label: "default", value: defaultValue });
}

/**
 * `mt-2` rather than an adjacent-sibling rule: the top margin collapses with
 * whatever precedes the first card, so a run of cards is spaced 0.5rem apart
 * while the first one still sits at the paragraph gap above it.
 */
const cardClass =
  "group mt-2 rounded-lg border border-border px-4 py-3.5 target:border-(--active) target:shadow-[0_0_0_1px_var(--active)]";

const footerClass =
  "-mx-4 -mb-3.5 flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-b-[calc(var(--radius-lg)-1px)] border-t border-border bg-muted px-4 py-2 text-[0.8rem] text-muted-foreground [&_code]:rounded-none [&_code]:bg-transparent [&_code]:px-0 [&_code]:py-0 [&_code]:text-[0.8rem] [&_code]:text-(--code-foreground)";
---

<ReferenceEntry id={name} class:list={[cardClass, deprecated && "opacity-60"]} anchor>
  <Fragment slot="heading">
    <code>{prefix && <span class="font-normal text-muted-foreground">{prefix}</span>}{leaf}</code>
    {required && <Badge tone="accent">required</Badge>}
    {deprecated && <Badge tone="muted">deprecated</Badge>}
  </Fragment>
  <slot />
  {facts.length > 0 && (
    <div slot="facts" class={footerClass}>
      {facts.map(({ label, value }) => (
        <span class="inline-flex items-baseline gap-1.5">
          <span class="font-medium">{label}</span>
          <code>{value}</code>
        </span>
      ))}
    </div>
  )}
</ReferenceEntry>
