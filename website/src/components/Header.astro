---
import {Menu, Search as SearchIcon} from "@lucide/astro";
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search.astro";
import SkipLink from "./SkipLink.astro";
import IconButton from "./IconButton.astro";
import {repoUrl} from "../lib/navigation";
import {latestVersion as resolveLatestVersion} from "../lib/docs";

interface Props {
    currentPath: string;
}

const {currentPath} = Astro.props;

const navLinks = [
    {href: "/getting-started", label: "Docs"},
    {href: "/api", label: "API"},
    {href: "/demo/", label: "Demo"},
];

const latestVersion = resolveLatestVersion();
const releaseUrl = `${repoUrl}/releases/tag/${latestVersion}`;
---
<SkipLink />

<header class="sticky top-0 z-50 border-b bg-background/80 backdrop-blur-lg select-none print:hidden" data-pagefind-ignore>
    <div class="mx-auto flex h-header max-w-shell items-center px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5 text-foreground font-semibold mr-8">
            <span class="text-xl">🐋</span>
            <span class="text-base">Cetacean</span>
        </a>

        <nav class="hidden md:flex items-center gap-1" aria-label="Main">
            {navLinks.map(({href, label}) => (
                <a
                    href={href}
                    class="rounded-md px-3 py-1.5 text-sm transition-colors current:font-medium current:text-active inactive:text-muted-foreground inactive:hover:text-foreground"
                    aria-current={currentPath.startsWith(href) ? "page" : undefined}
                >
                    {label}
                </a>
            ))}
        </nav>

        <Search />

        <div class="ml-auto md:ml-0 flex items-center gap-1">
            <IconButton
                id="search-trigger-mobile"
                class="md:hidden rounded-md p-1.5"
                aria-label="Search"
            >
                <SearchIcon class="size-5" aria-hidden="true" />
            </IconButton>

            <a
                href={releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex items-center rounded-md px-2 py-1 text-xs font-medium text-muted-foreground hover:text-foreground border hover:bg-accent transition-colors"
                aria-label={`${latestVersion} release notes (opens in new tab)`}
            >
                {latestVersion}
            </a>

            <IconButton
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md p-1.5"
                aria-label="GitHub (opens in new tab)"
            >
                <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
                </svg>
            </IconButton>

            <ThemeToggle />

            <IconButton
                id="mobile-menu-toggle"
                class="md:hidden rounded-md p-1.5"
                aria-label="Menu"
                aria-expanded="false"
                aria-controls="mobile-sidebar"
            >
                <Menu class="size-5" aria-hidden="true" />
            </IconButton>
        </div>
    </div>
</header>
