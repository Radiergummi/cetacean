---
import CopyPageButton from "@/components/CopyPageButton.astro";

interface Props {
    title: string;
    markdownUrl?: string;
    editUrl?: string;
    category?: string;
    tags?: string[];
    description?: string;
}

const {
    title,
    tags,
    category,
    description,
    markdownUrl,
    editUrl,
} = Astro.props;
---
<span class="hidden" data-pagefind-meta="description">{description}</span>

{category && <meta data-pagefind-filter={`category:${category}`} />}

{tags?.map((tag) => <meta data-pagefind-filter={`tag:${tag}`} />)}

<div
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6"
    data-pagefind-ignore
>
    <h1
        class="text-2xl font-semibold tracking-tight m-0"
        data-pagefind-meta="title"
    >
        {title}
    </h1>
    {markdownUrl && editUrl && (
        <CopyPageButton markdownUrl={markdownUrl} editUrl={editUrl} />
    )}
</div>
