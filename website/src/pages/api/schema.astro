---
import Heading from "@/components/Heading.astro";
import SchemaDefinition from "@/components/SchemaDefinition.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import Badge from "../../components/Badge.astro";
import {properties, rfc9457Properties, types} from "@/lib/schema.ts";

const allProperties = [
    ...properties,
    ...rfc9457Properties,
].sort((a, b) => a.name.localeCompare(b.name));

const headings = [
    {depth: 2, slug: "types", text: "Types"},
    ...types.map(({name}) => ({depth: 3, slug: name, text: name})),
    {depth: 2, slug: "properties", text: "Properties"},
    ...allProperties.map(({name}) => ({depth: 3, slug: name, text: name})),
];
---
<DocsLayout
    title="Schema Reference"
    description="JSON-LD vocabulary for the Cetacean API: types, properties, and their IRIs."
    slug="api/schema"
    headings={headings}
>
    <p>
        Cetacean API responses include <a href="https://json-ld.org/">JSON-LD</a> metadata
        (<code>@context</code>, <code>@id</code>, <code>@type</code>) for self-description.
        This page documents the vocabulary. The machine-readable context document is available
        at <a href="/api/schema.jsonld"><code>/api/schema.jsonld</code></a>.
    </p>

    <section>
        <header>
            <Heading level={2} id="types" anchor>Types</Heading>
            <p>Each API response includes an <code>@type</code> value identifying the resource kind.</p>
        </header>

        <ul class="flex flex-col gap-y-4 m-0">
            {types.map(({description, endpoint, name, properties: typeProperties}) => (
                <li class="contents">
                    <SchemaDefinition name={name} description={description}>
                        <Fragment slot="facts">
                            <dt class="font-medium">Endpoint</dt>
                            <dd><code>{endpoint}</code></dd>

                            {typeProperties.length > 0 && (
                                <>
                                    <dt class="font-medium">Properties</dt>
                                    <dd>
                                        <ul class="flex flex-wrap gap-x-1 gap-y-0.5 m-0">
                                            {typeProperties.map((property, index) => (
                                                <li class="contents">
                                                    {index > 0 && ", "}
                                                    <a href={`/api/schema#${property}`}><code>{property}</code></a>
                                                </li>
                                            ))}
                                        </ul>
                                    </dd>
                                </>
                            )}
                        </Fragment>
                    </SchemaDefinition>
                </li>
            ))}
        </ul>
    </section>

    <section>
        <header>
            <Heading level={2} id="properties" anchor>Properties</Heading>
            <p>
                Properties are mapped to IRIs via the <code>@context</code>. The <code>urn:cetacean:</code> namespace
                is the default vocabulary; <a href="https://www.rfc-editor.org/info/rfc9457/" rel="noopener nofollow">RFC
                9457</a> problem detail fields use <code>urn:ietf:rfc:9457#</code>.
            </p>
        </header>

        <ul class="flex flex-col gap-y-4 m-0">
            {allProperties.map(({
                container,
                description,
                expectedType,
                iri,
                name,
                usedOn,
            }) => (
                <li class="contents">
                    <SchemaDefinition
                        name={name}
                        container={container}
                    >

                        <p slot="description" set:html={description.replace(/`([^`]+)`/g, "<code>$1</code>")} />

                        <Fragment slot="facts">
                            <dt class="font-medium">IRI</dt>
                            <dd><code>{iri}</code></dd>

                            <dt class="font-medium">Type</dt>
                            <dd><code>{expectedType}</code></dd>

                            <dt class="font-medium">Used on</dt>
                            {usedOn.length > 0 && (
                                <>
                                    <dd>
                                        <ul class="flex flex-wrap gap-x-1 gap-y-0.5 m-0">
                                            {usedOn.map((property, index) => (
                                                <li class="contents">
                                                    {index > 0 && ", "}
                                                    <a href={`/api/schema#${property}`}>{property}</a>
                                                </li>
                                            ))}
                                        </ul>
                                    </dd>
                                </>
                            )}
                        </Fragment>
                    </SchemaDefinition>
                </li>
            ))}

        </ul>
    </section>
</DocsLayout>
