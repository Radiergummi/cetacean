---
import PageFooter from "@/components/PageFooter.astro";
import PageHeader from "@/components/PageHeader.astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MermaidViewport from "../components/MermaidViewport.astro";
import {repoUrl} from "../lib/navigation";
import {getLastModified} from "../lib/git";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    title: string;
    description: string;
    slug: string;
    headings: Heading[];
    markdownUrl?: string;
    category?: string;
    tags?: string[];

    /**
     * The page's source file, relative to the repository root. Pages generated
     * from Go source have none, and get neither an edit link nor a modified
     * date rather than a link to a file that was never written.
     */
    sourcePath?: string;
}

const {
    title,
    description,
    slug,
    headings,
    markdownUrl,
    category,
    tags,
    sourcePath,
} = Astro.props;
const lastModified = sourcePath ? await getLastModified(sourcePath) : null;
const editUrl = sourcePath ? `${repoUrl}/edit/main/${sourcePath}` : null;
---

<BaseLayout title={title} description={description} slug={slug} lastModified={lastModified}>
    <main
        id="main-content"
        class="flex-1 min-w-0 py-10 px-8 md:px-12 lg:px-16"
        transition:animate="fade"
    >
        <article class="mx-auto" data-pagefind-body>
            <PageHeader
                title={title}
                editUrl={editUrl}
                markdownUrl={markdownUrl}
                tags={tags}
                description={description}
                category={category}
            />

            <div class="prose">
                <slot />
            </div>

            <PageFooter slug={slug} lastModified={lastModified} editUrl={editUrl} />
        </article>
    </main>

    <TableOfContents headings={headings} />

    <MermaidViewport />

    <div id="copy-status" class="sr-only" aria-live="polite" role="status"></div>

    <script is:inline>
        const copyClass =
            "cursor-pointer px-1 py-0.25 text-2xs font-medium uppercase tracking-wide text-muted-foreground transition-colors hover:text-foreground select-none";

        function copyWithFeedback(button, text) {
            navigator.clipboard.writeText(text).then(() => {
                button.textContent = "Copied!";

                const status = document.getElementById("copy-status");

                if (status) {
                    status.textContent = "Copied to clipboard";
                }

                setTimeout(() => {
                    button.textContent = "Copy";

                    if (status) {
                        status.textContent = "";
                    }
                }, 2000);
            });
        }

        document.addEventListener("astro:page-load", () => {
            // Hide HTTP request separators (###).
            document
                .querySelectorAll("pre[data-language=\"http\"] .line")
                .forEach((line) => {
                    if (line.textContent.trim() === "###") {
                        line.style.display = "none";
                    }
                });

            document
                .querySelectorAll(".prose table:not([data-initialized])")
                .forEach((table) => {
                    table.setAttribute("data-initialized", "");

                    const wrapper = document.createElement("div");
                    wrapper.className = "my-6 overflow-x-auto -mx-1 px-1";

                    table.parentNode.insertBefore(wrapper, table);
                    wrapper.appendChild(table);
                });

            document
                .querySelectorAll(".prose pre:not([data-initialized])")
                .forEach((pre) => {
                    pre.setAttribute("data-initialized", "");

                    if (pre.closest(".code-tabs")) {
                        return;
                    }

                    const wrapper = document.createElement("div");
                    wrapper.className = "relative";

                    pre.parentNode.insertBefore(wrapper, pre);
                    wrapper.appendChild(pre);

                    const button = document.createElement("button");
                    button.className = `absolute right-1.5 top-1.5 z-1 ${copyClass}`;
                    button.textContent = "Copy";

                    button.addEventListener("click", () => {
                        const code = pre.querySelector("code");

                        copyWithFeedback(
                            button,
                            code ? code.textContent : pre.textContent,
                        );
                    });
                    wrapper.appendChild(button);
                });

            // Code tabs: switch panels and persist preference.
            const tabPrefs = JSON.parse(
                localStorage.getItem("code-tab-prefs") || "{}",
            );

            document
                .querySelectorAll(".code-tabs:not([data-initialized])")
                .forEach((tabs) => {
                    tabs.setAttribute("data-initialized", "");

                    const bar = tabs.querySelector(".code-tabs-bar");
                    const buttons = bar.querySelectorAll(".code-tabs-button");

                    const copyButton = document.createElement("button");
                    copyButton.className = `ml-auto ${copyClass}`;
                    copyButton.textContent = "Copy";

                    copyButton.addEventListener("click", () => {
                        const activeCode = tabs.querySelector(
                            ".code-tab-panel.active code",
                        );

                        if (activeCode) {
                            copyWithFeedback(
                                copyButton,
                                activeCode.textContent,
                            );
                        }
                    });
                    bar.appendChild(copyButton);

                    const labels = Array.from(buttons).map(
                        ({textContent}) => textContent,
                    );

                    const preferred = labels.find((label) => tabPrefs[label]);

                    if (preferred) {
                        activateGroup(tabs, labels.indexOf(preferred));
                    }

                    bar.addEventListener("click", (event) => {
                        const button = event.target.closest(".code-tabs-button");

                        if (!button) {
                            return;
                        }

                        const index = Number(button.dataset.tab);

                        activateGroup(tabs, index);

                        tabPrefs[buttons[index].textContent] = true;

                        localStorage.setItem("code-tab-prefs", JSON.stringify(tabPrefs));

                        const label = buttons[index].textContent;

                        document
                            .querySelectorAll(".code-tabs")
                            .forEach((other) => {
                                if (other === tabs) {
                                    return;
                                }

                                other
                                    .querySelectorAll(".code-tabs-button")
                                    .forEach(({textContent}, index) => {
                                        if (textContent === label) {
                                            activateGroup(other, index);
                                        }
                                    });
                            });
                    });
                });

            function activateGroup(group, index) {
                const buttons = group.querySelectorAll(".code-tabs-button");
                const panels = group.querySelectorAll(".code-tab-panel");

                buttons.forEach((button) => {
                    button.classList.remove("active");
                    button.setAttribute("aria-selected", "false");
                });

                panels.forEach((panel) => panel.classList.remove("active"));

                if (buttons[index]) {
                    buttons[index].classList.add("active");
                    buttons[index].setAttribute("aria-selected", "true");
                }

                panels[index]?.classList.add("active");
            }
        });
    </script>
</BaseLayout>
