{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:demo": "vite build --config vite.config.demo.ts && cp ../website/public/demo/demo.html ../website/public/demo/index.html && cp ../website/public/demo/demo.html ../website/public/demo/404.html",
    "check": "tsc -b",
    "dev": "vite",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.102.7",
    "@tanstack/react-query-devtools": "^5.102.7",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.5",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "elkjs": "^0.11.1",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-response-validator": "^12.1.3",
    "oxfmt": "0.57.0",
    "oxlint": "1.80.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "fast-uri": ">=4.1.2",
    "hono": ">=4.12.34",
    "ip-address": ">=10.3.1",
    "postcss": ">=8.5.23",
    "undici": ">=7.29.0"
  },
  "allowScripts": {
    "msw@2.15.0": true
  },
  "msw": {
    "workerDirectory": [
      "../website/public/demo"
    ]
  }
}
