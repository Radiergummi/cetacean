{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "import", "vitest", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-deps": "warn",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-render-return-value": "error",
    "react/void-dom-elements-no-children": "error",
    "react/jsx-no-constructed-context-values": "warn",
    "react/no-this-in-sfc": "error",
    "react/no-array-index-key": "off",
    // Every report is a `cell: ({ ID }) => <Link…>` render prop in a DataTable
    // column definition. Those are not components — React never mounts them as
    // one — so the stale-state hazard the rule warns about cannot occur.
    "react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
    "react-hooks/rules-of-hooks": "error",
    "react/refs": "error",
    // React Compiler rules, added to oxlint's `correctness` category in 1.7x
    // and therefore auto-promoted to errors by the category setting above.
    // They flag real smells, but each needs an individual behavioural fix
    // rather than a mechanical one, so they run as warnings until worked down.
    // `refs` is deliberately kept at "error" above: the render-phase ref
    // writes it found are fixed (see hooks/useLatestRef.ts), and the few
    // remaining sites carry file-level `oxlint-disable` comments explaining
    // why they are intentional. New ones should not slip in.
    "react/set-state-in-effect": "warn",
    "react/static-components": "warn",
    "react/purity": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/incompatible-library": "warn",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    // Private fields deliberately stashed on objects owned by other libraries:
    // `_rawData` on a Chart.js dataset, `_elkHeight` on a React Flow node's
    // data, `_values` in vendored shadcn slider code.
    "no-underscore-dangle": ["warn", { "allow": ["_values", "_rawData", "_elkHeight"] }],
    "no-shadow": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-wrappers": "error",
    "no-void": ["error", { "allowAsStatement": true }],
    // A label wrapping its own control associates implicitly, but the rule
    // only sees that through components it has been told are controls.
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "labelComponents": ["Label"],
        "controlComponents": [
          "Switch",
          "Input",
          "DurationInput",
          "NumberField",
          "MultiCombobox",
          "Combobox",
          "Slider"
        ],
        "depth": 5
      }
    ],
    // Upstream jsx-a11y ships default element/role pairs for exactly these
    // cases; oxlint's port does not, so they are restored here. `role="grid"`
    // on a `<table>` is the correct way to build a keyboard-navigable grid,
    // and `role="presentation"` on a `<tr>` is how a layout row says it is not
    // part of the data.
    "jsx-a11y/no-noninteractive-element-to-interactive-role": [
      "error",
      {
        "table": ["grid"],
        "td": ["gridcell"],
        "ul": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
        "ol": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
        "li": ["menuitem", "option", "row", "tab", "treeitem"]
      }
    ],
    "jsx-a11y/no-interactive-element-to-noninteractive-role": [
      "error",
      {
        "tr": ["none", "presentation"],
        "td": ["none", "presentation"],
        "tbody": ["none", "presentation"],
        "thead": ["none", "presentation"],
        "tfoot": ["none", "presentation"]
      }
    ],
    // Reports every empty spacer `<td>`/`<th>` as an unlabelled control. A
    // table cell is not a control, and the layout cells a virtualized body and
    // the skeletons need are exactly what it flags — 17 reports, none of them
    // a real one.
    "jsx-a11y/control-has-associated-label": "off",
    // Its advice is unsound for the two patterns this app actually uses:
    // `role="status"` on a live region is not `<output>` (a form calculation
    // result), and `role="img"` on a composed graphic is not `<img>` (which
    // needs a src). Same for `role="combobox"`/`listbox`/`option` on the query
    // input, where the suggested `<select>` is a different widget.
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": "off"
  },
  "settings": {
    "react": {
      "version": "19.2.0"
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      // Tests drive sequences that have to happen in order — a reconnect
      // attempt, then the next one — so awaiting inside the loop is the point.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
