#!/usr/bin/env bash
# Regenerate the committed SBOM when a dependency manifest is staged, so it
# never drifts from the lockfiles. No-ops for commits that don't touch
# dependencies, and skips gracefully when the SBOM toolchain is absent (CI is
# the real gate). Install with: make hooks
set -euo pipefail

staged="$(git diff --cached --name-only)"
case "$staged" in
  *go.mod*|*go.sum*|*package.json*|*pnpm-lock.yaml*) ;;
  *) exit 0 ;;
esac

# cyclonedx-gomod resolves the main module through go-git, which does not follow
# a linked worktree's .git *file* and fails with "failed to determine version of
# main module: reference not found". Nothing in the worktree can fix that, so
# skip (don't block) — same as every other can't-run-here case below.
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
  echo "pre-commit: linked worktree; cyclonedx-gomod cannot resolve the main module here. Skipping SBOM regeneration (CI regenerates and commits it)." >&2
  exit 0
fi

# Both generators are Go now — the tool directive pins cyclonedx-gomod, and
# scripts/sbomnpm reads the lockfile — so only go and jq are needed, plus an
# installed workspace. Skip (don't block) when anything is missing.
for tool in go jq; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "pre-commit: '$tool' missing; skipping SBOM regeneration (CI regenerates and commits it)." >&2
    exit 0
  fi
done

if [ ! -d node_modules/.pnpm ]; then
  echo "pre-commit: workspace not installed; run 'pnpm install'. Skipping SBOM regeneration (CI regenerates and commits it)." >&2
  exit 0
fi

# cyclonedx-gomod compiles the package, so main.go's //go:embed frontend/dist/*
# needs a built frontend. Skip (don't block) when it's absent — CI handles it.
if [ -z "$(ls -A frontend/dist 2>/dev/null)" ]; then
  echo "pre-commit: frontend/dist missing; run 'pnpm --filter frontend build'. Skipping SBOM regeneration (CI regenerates and commits it)." >&2
  exit 0
fi

echo "pre-commit: dependency manifest changed, regenerating SBOM…"
make sbom

# Everything build-sbom.sh writes, not just the CycloneDX document: staging a
# subset leaves the rest dirty in the working tree after the commit, and the
# commit itself carries an SBOM whose attribution half disagrees with it.
grep -v '^#' scripts/sbom-artifacts.txt | xargs git add --
